{
  "name": "@deepseek-ai/dsh-hivemind-web-app",
  "description": "HIVE-MIND chat-only Web profile layer",
  "version": "0.1.3-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./presets/*.agent.yml": "./presets/*.agent.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "presets/*.patch.yml",
    "presets/*.agent.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/hivemind-chat.patch.yml",
        "./presets/hivemind-hq.patch.yml",
        "./presets/hivemind-hyperagents.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-hivemind-employee-delegation": "workspace:^",
    "@deepseek-ai/dsh-http-proxy": "workspace:^",
