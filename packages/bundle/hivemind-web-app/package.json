    "@deepseek-ai/dsh-experimental-tool-agent-team": "workspace:^",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "workspace:^",
    "@deepseek-ai/dsh-client-ui-hivemind-connect": "workspace:^",
    "@deepseek-ai/dsh-hivemind-execution-scope": "workspace:^",
    "@deepseek-ai/dsh-hivemind-web-runner": "workspace:^",
    "@deepseek-ai/dsh-hivemind-virtual-workspace": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-postgres": "workspace:^",
    "@deepseek-ai/dsh-hivemind-schedule-postgres": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-client-ui-schedule": "workspace:^",
    "@deepseek-ai/dsh-hivemind-dreamer": "workspace:^",
    "@deepseek-ai/dsh-hivemind-connected-apps": "workspace:^",
    "@deepseek-ai/dsh-hivemind-progressive-skills": "workspace:^",
