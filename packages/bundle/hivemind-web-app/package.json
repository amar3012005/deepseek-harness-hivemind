{
  "name": "@deepseek-ai/dsh-hivemind-web-app",
  "description": "HIVE-MIND chat-only Web profile layer",
  "version": "0.1.3-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
