{
  "name": "@deepseek-ai/dsh-client-pdf-assets",
  "description": "Lazy build-owned PDF worker, font, CMap and decoder resources",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/pdf-assets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ]
}
