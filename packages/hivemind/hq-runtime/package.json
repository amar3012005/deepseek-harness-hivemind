{
  "name": "@deepseek-ai/dsh-hivemind-hq-runtime",
  "description": "HQ task requirements, verified receipts, and human-controlled autonomy over native Teams and Schedule",
  "version": "0.1.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/hivemind/hq-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./control": {
      "types": "./lib/types/control.d.ts",
      "default": "./lib/control.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./ownership": {
      "types": "./lib/types/ownership.d.ts",
      "default": "./lib/ownership.js"
    },
    "./ownership-postgres": {
      "types": "./lib/types/ownership-postgres.d.ts",
      "default": "./lib/ownership-postgres.js"
    }
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.d.ts",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "migrations/*.sql"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-hivemind-execution-scope": "workspace:^",
    "@deepseek-ai/dsh-hivemind-employee-directory": "workspace:^",
    "@deepseek-ai/dsh-hivemind-employee-delegation": "workspace:^",
    "@deepseek-ai/dsh-tool-todo": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-hivemind-execution-scope": "workspace:^",
    "@types/pg": "^8.11.10",
    "@deepseek-ai/dsh-hivemind-employee-directory": "workspace:^",
    "@deepseek-ai/dsh-hivemind-employee-delegation": "workspace:^",
    "@deepseek-ai/dsh-tool-todo": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  }
}
