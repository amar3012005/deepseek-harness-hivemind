ARG BRAIN_BASE
FROM ${BRAIN_BASE}
USER root
WORKDIR /opt/deepseek-harness
COPY pnpm-lock.yaml pnpm-lock.yaml
COPY packages/hivemind/web-runner/ packages/hivemind/web-runner/
COPY packages/hivemind/artifact-renderer/ packages/hivemind/artifact-renderer/
COPY packages/api/session-controller/ packages/api/session-controller/
COPY packages/client/ui-model-selection/ packages/client/ui-model-selection/
COPY packages/client/ui-conversation/ packages/client/ui-conversation/
RUN pnpm install --offline --frozen-lockfile --ignore-scripts \
 && node node_modules/typescript/bin/tsc -b packages/hivemind/web-runner packages/client/ui-model-selection packages/client/ui-conversation \
 && node node_modules/tsdown/dist/run.mjs --env.DSH_BUILD_FACE host --filter @deepseek-ai/dsh-api-session-controller --filter @deepseek-ai/dsh-hivemind-web-runner --filter @deepseek-ai/dsh-hivemind-artifact-renderer \
 && (cd packages/client/ui-model-selection && node ../../../node_modules/tsdown/dist/run.mjs --env.DSH_BUILD_FACE client --config tsdown.config.ts) \
 && (cd packages/client/ui-conversation && node ../../../node_modules/tsdown/dist/run.mjs --env.DSH_BUILD_FACE client --config tsdown.config.ts) \
 && grep -q 'Follow Usage default' packages/client/ui-model-selection/lib/client.js \
 && grep -q 'hivemind:room-call-status-request' packages/client/ui-conversation/lib/client.js
ARG SOURCE_SHA
ENV DSH_CLIENT_COMMIT_HASH=$SOURCE_SHA
LABEL org.opencontainers.image.revision=$SOURCE_SHA com.singulance.scope=brain-connected-composer
USER node
