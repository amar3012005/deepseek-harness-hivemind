# Compatible immutable base; build context contains the complete reviewed Git delta.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
ARG DSH_CLIENT_COMMIT_HASH
ENV DSH_CLIENT_COMMIT_HASH=${DSH_CLIENT_COMMIT_HASH} NARB_DISABLE_NATIVE_CACHE=1
WORKDIR /opt/deepseek-harness
COPY . .
RUN corepack enable && pnpm run build:lib && pnpm run build:web
LABEL org.opencontainers.image.revision=${DSH_CLIENT_COMMIT_HASH}
LABEL com.singulance.service=harness-runner
USER node
