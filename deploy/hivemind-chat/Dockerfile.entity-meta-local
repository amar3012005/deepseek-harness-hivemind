ARG BASE_IMAGE=hivemind/harness-chat:2d29c33a44013125de54de8df9b2281638fbfa86
FROM ${BASE_IMAGE}

USER root
COPY --chown=node:node packages/hivemind/memory/src /opt/deepseek-harness/packages/hivemind/memory/src
COPY --chown=node:node packages/hivemind/runtime/src /opt/deepseek-harness/packages/hivemind/runtime/src
COPY --chown=node:node packages/preset/agent-presets/presets/hivemind-chat/agent.cordis.yml /opt/deepseek-harness/packages/preset/agent-presets/presets/hivemind-chat/agent.cordis.yml
RUN ./node_modules/.bin/tsc -b packages/hivemind/memory/tsconfig.json packages/hivemind/runtime/tsconfig.json \
  && ./node_modules/.bin/tsdown --filter @deepseek-ai/dsh-hivemind-memory \
  && cd packages/hivemind/runtime \
  && ../../../node_modules/.bin/tsdown
USER node
