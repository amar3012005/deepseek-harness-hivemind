ARG HIVEMIND_HARNESS_BASE=hivemind/harness-chat:pre-jev-fb65f0c00f
FROM ${HIVEMIND_HARNESS_BASE}

ARG DSH_CLIENT_COMMIT_HASH
LABEL org.opencontainers.image.revision=${DSH_CLIENT_COMMIT_HASH}
LABEL com.singulance.harness.base=pre-jev-fb65f0c00f
LABEL com.singulance.harness.overlay=memory-connected-streaming-hardening

USER root
WORKDIR /opt/deepseek-harness

# Overlay only the two rebuilt Cordis plugins and the reviewed profile/config
# files. The verified pre-JEV runner remains the complete immutable base.
COPY packages/hivemind/memory/lib/ packages/hivemind/memory/lib/
COPY packages/hivemind/connected-apps/lib/ packages/hivemind/connected-apps/lib/
COPY packages/preset/agent-presets/presets/hivemind-chat/agent.cordis.yml packages/preset/agent-presets/presets/hivemind-chat/agent.cordis.yml
COPY packages/bundle/hivemind-web-app/cordis.patch.yml packages/bundle/hivemind-web-app/cordis.patch.yml
COPY deploy/hivemind-chat/profile-smoke.mjs deploy/hivemind-chat/profile-smoke.mjs

USER node
